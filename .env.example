# Copy to .env (gitignored) and fill in. Sandbox values only.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Backend refuses anything other than the sandbox URL
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# SQLite file for the backend (gitignored via *.db)
PAYOUTGUARD_DB=payoutguard.db
# Sandbox Personal account emails, comma-separated, no spaces. Not the business account that owns the app.
RECEIVERS=
# One of those emails with one character changed
TYPO_RECEIVER=
